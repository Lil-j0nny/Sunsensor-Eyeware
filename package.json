{
  "name": "sunsensor-eyewear",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "pnpm check && vite build && node scripts/prerender.mjs && pnpm build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "check": "tsc -b --pretty false && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "express": "5.1.0",
    "lucide-react": "0.468.0",
    "motion": "12.23.24",
    "mysql2": "3.15.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "6.3.6"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6"
  }
}
